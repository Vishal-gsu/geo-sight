# Google Earth Engine Configuration
# For local development, you can leave these blank and just run `earthengine authenticate` in the terminal.
# For production/automation, provide the service account email and path to the downloaded JSON key.

# Your Google Cloud Project ID (Required for modern GEE API)
EE_PROJECT_ID=your-google-cloud-project-id

# Service Account details (Optional, for Production)
EE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
EE_PRIVATE_KEY_PATH=./path/to/service-account-key.json

# Add any other API keys here (e.g. for fetching additional data)
# SOME_OTHER_API_KEY=your-api-key-here
